        /* tela de carregamento */
        #transfer {
            position: fixed; inset: 0; z-index: 100;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center; gap: 14px;
            background: radial-gradient(1200px 600px at 50% 30%, #1c1f28, #16181e 70%);
            text-align: center; padding: 24px;
        }
        /* o runtime esconde via atributo `hidden` -> garantir que o display: flex acima
           nao venca o [hidden] */
        #transfer[hidden] { display: none !important; }
        #transfer .pulse {
            width: 46px; height: 46px; border-radius: 50%;
            background: radial-gradient(circle at 50% 50%, #8ec9ff, #5b8cff 55%, transparent 72%);
            animation: pulse 1.25s ease-in-out infinite;
        }
        @keyframes pulse {
            0%, 100% { transform: scale(.78); opacity: .65; }
            50%      { transform: scale(1.12); opacity: 1; }
        }
        #transfer h1 {
            margin: 6px 0 0; font-size: 1.45rem; font-weight: 650;
            letter-spacing: .2px; color: #eef1f6; max-width: 34ch; line-height: 1.3;
        }
        #transfer .sub { margin: 0; color: #99a1b3; font-size: .92rem; max-width: 42ch; }
        #status {
            margin: 6px 0 0; color: #8b93a5; font-weight: 500; font-size: .85rem;
        }
        #progress {
            -webkit-appearance: none; appearance: none;
            width: min(440px, 74vw); height: 8px;
            border: 0; border-radius: 99px; background: #2a2e39; overflow: hidden;
        }
        #progress::-webkit-progress-bar { background: #2a2e39; border-radius: 99px; }
        #progress::-webkit-progress-value {
            background: linear-gradient(90deg, #5b8cff, #8ec9ff);
            border-radius: 99px; transition: width .25s ease;
        }
        #progress::-moz-progress-bar {
            background: linear-gradient(90deg, #5b8cff, #8ec9ff); border-radius: 99px;
        }

        /* caixa de status do pygbag ("installing numpy", "click page"): oculta —
           a tela #transfer (com #status) ja informa o progresso. O elemento
           permanece no DOM para os scripts do template nao quebrarem. */
        #infobox { display: none !important; }

